# Create an app at https://developer.spotify.com/dashboard and fill these in.
# Register http://127.0.0.1:8787/auth/callback as the Redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# PORT=8787
# DB_PATH=data/listening.db

# Production (see README "Deploy"):
# COLLECT=0                      # web server only; the worker collects
# DATA_REPO_DIR=/path/to/clone   # git clone of the listening-archive repo the worker pushes to
# ARCHIVE_PUSH_MINUTES=15
# SPOTIFY_REDIRECT_URI=https://your-host/auth/callback
# HOST=127.0.0.1
