# Example unit: adjust User, the paths and the node binary to your machine.
[Unit]
Description=Sleeve web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=listening
WorkingDirectory=/opt/sleeve
EnvironmentFile=/opt/sleeve/.env
Environment=COLLECT=0
ExecStart=/usr/bin/node server/index.ts
# Files it creates stay readable by this user only: the database holds the Spotify refresh token.
UMask=0077
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
