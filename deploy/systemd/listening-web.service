# Example unit: adjust User, the paths and the node binary to your machine.
[Unit]
Description=Listening Log web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=listening
WorkingDirectory=/opt/spotify-calendar
EnvironmentFile=/opt/spotify-calendar/.env
Environment=COLLECT=0
ExecStart=/usr/bin/node server/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
