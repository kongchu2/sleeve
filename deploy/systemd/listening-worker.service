# Example unit: adjust User, the paths and the node binary to your machine.
[Unit]
Description=Sleeve collector worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=listening
WorkingDirectory=/opt/sleeve
EnvironmentFile=/opt/sleeve/.env
ExecStart=/usr/bin/node server/worker.ts
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
