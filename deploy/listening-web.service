[Unit]
Description=Listening Log web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/spotify-calendar
EnvironmentFile=/home/ubuntu/spotify-calendar/.env
Environment=COLLECT=0
ExecStart=/home/ubuntu/.local/node/bin/node server/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
