{
  "name": "spotify-calendar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"APP_URL=http://127.0.0.1:5180 node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "worker": "node --env-file-if-exists=.env server/worker.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
